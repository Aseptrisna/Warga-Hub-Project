# Application
NODE_ENV=development
PORT=3000
API_PREFIX=api/v1

# MongoDB
MONGODB_URI=mongodb://localhost:27017/wargahub

# JWT
JWT_SECRET=your-super-secret-jwt-key-change-in-production
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=your-refresh-secret-change-in-production
JWT_REFRESH_EXPIRES_IN=7d

# CORS
CORS_ORIGIN=http://localhost:5173

# File Upload
MAX_FILE_SIZE=5242880
UPLOAD_PATH=./uploads

# Frontend
FRONTEND_URL=http://localhost:5173

# Payment Gateway (QRIS via PaymentGatewayService)
# Placeholder values - dev only. Register WargaHub as a client app with:
#   go run ./cmd/seed -name "wargahub" -callback-url "https://<public-domain>/api/v1/payment-gateway/webhook"
# then replace PAYMENT_GATEWAY_API_KEY / PAYMENT_GATEWAY_CALLBACK_SECRET with
# the values it prints (shown once).
PAYMENT_GATEWAY_BASE_URL=http://localhost:8090/api/v1/payments
PAYMENT_GATEWAY_API_KEY=pgw_live_placeholder
PAYMENT_GATEWAY_CALLBACK_SECRET=whsec_placeholder

# Email (SMTP - forgot password, notifications, email verification)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=your-email@gmail.com
EMAIL_PASSWORD=your-app-password
EMAIL_FROM=WargaHub <your-email@gmail.com>

# S3-compatible object storage - file uploads (foto, bukti, dokumen)
AWS_REGION=your-region
AWS_ACCESS_KEY_ID=your-access-key-id
AWS_SECRET_ACCESS_KEY=your-secret-access-key
AWS_S3_BUCKET=your-bucket-name
AWS_S3_ENDPOINT=https://your-s3-endpoint
AWS_S3_PUBLIC_URL=https://your-s3-endpoint
